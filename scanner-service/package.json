{
  "name": "scanner-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A11YSCAPE website accessibility collection service",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --disable-warning=ExperimentalWarning --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../.env --disable-warning=ExperimentalWarning dist/server.js",
    "db:init": "node --env-file-if-exists=../.env --disable-warning=ExperimentalWarning --import tsx scripts/init-db.ts",
    "db:migrate": "node --env-file-if-exists=../.env --disable-warning=ExperimentalWarning --import tsx scripts/migrate.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/urlGuard.test.ts test/axeMapping.test.ts test/store.test.ts test/api.test.ts"
  },
  "dependencies": {
    "axe-core": "^4.10.0",
    "ipaddr.js": "^2.2.0",
    "playwright": "1.48.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
