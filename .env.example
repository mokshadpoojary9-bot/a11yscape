# ---------------------------------------------------------------------------
# A11YSCAPE environment template
# Copy to .env and adjust. NEVER commit a filled .env file.
# ---------------------------------------------------------------------------

# --- Frontend (Vite) -------------------------------------------------------
# Base URL of the website scanning service (Phase 2).
VITE_SCANNER_API_URL=http://localhost:4000

# Base URL of the R Plumber analytics API (Phase 4+).
VITE_R_API_URL=http://localhost:8000

# --- Scanner service (Phase 2) --------------------------------------------
NODE_ENV=development
PORT=4000

# SQLite database file, relative to the repository root.
DATABASE_PATH=./database/a11yscape.sqlite

# Scan limits
SCAN_TIMEOUT_MS=45000
SCAN_MAX_PAGES=5
SCAN_USER_AGENT=A11YSCAPE-Research-Bot/0.1

# Allowed CORS origin for the frontend dev server.
CORS_ORIGIN=http://localhost:5173

# --- R analytics engine (Phase 4+) ----------------------------------------
R_PORT=8000
